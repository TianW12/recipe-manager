# Template for .env — copy to `.env` and fill in real values:
#   cp .env.example .env
# Generate a key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# SMTP for verification emails (any provider free tier: Brevo, Resend, Gmail…).
# Leave SMTP_HOST empty/unset in development: codes are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
